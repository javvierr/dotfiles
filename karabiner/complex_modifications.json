{
    "description": "ctrl + m to return",
    "manipulators": [
        {
            "from": {
                "key_code": "m",
                "modifiers": {
                    "mandatory": [
                        "left_control"
                    ]
                }
            },
            "to": [
                {
                    "key_code": "return_or_enter",
                    "repeat": true
                }
            ],
            "type": "basic"
        }
    ]
}


