
{
    "description": "Toggle caps_lock by pressing left_shift then right_shift",
    "manipulators": [
        {
            "from": {
                "key_code": "left_shift",
                "modifiers": {
                    "mandatory": [
                        "right_shift"
                    ],
                    "optional": [
                        "caps_lock"
                    ]
                }
            },
            "to": [
                {
                    "key_code": "caps_lock"
                }
            ],
            "to_if_alone": [
                {
                    "key_code": "left_shift"
                }
            ],
            "type": "basic"
        },
        {
            "from": {
                "key_code": "right_shift",
                "modifiers": {
                    "mandatory": [
                        "left_shift"
                    ],
                    "optional": [
                        "caps_lock"
                    ]
                }
            },
            "to": [
                {
                    "key_code": "caps_lock"
                }
            ],
            "to_if_alone": [
                {
                    "key_code": "right_shift"
                }
            ],
            "type": "basic"
        }
    ]
}

